{
  "name": "proxy-routing-extension",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "prepare": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:docs && pnpm spellcheck && pnpm validate:workflows && pnpm validate:store-assets && pnpm validate:traceability && pnpm test:unit && pnpm test:parity",
    "audit": "pnpm audit --audit-level high",
    "licenses": "pnpm licenses list --prod --json",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:permission-warnings": "node scripts/validate-permission-warnings.mjs",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:source-rebuild": "node scripts/validate-source-rebuild.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:workflows": "node scripts/validate-workflows.mjs",
    "validate:store-assets": "node scripts/validate-store-assets.mjs",
    "validate:traceability": "node scripts/validate-traceability.mjs",
    "publish:github-release": "node scripts/publish-github-release.mjs",
    "capture:store-assets": "node scripts/capture-store-assets.mjs",
    "capture:readme-screenshots": "node scripts/capture-readme-screenshots.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "scan:artifacts": "node scripts/scan-artifacts.mjs",
    "scan:test-artifacts": "node scripts/scan-artifacts.mjs --inspect-archives test-results playwright-report",
    "package:artifacts": "node scripts/package-artifacts.mjs",
    "spellcheck": "cspell --no-progress",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:parity": "vitest run tests/parity",
    "test:performance": "vitest run tests/performance",
    "pretest:soak": "pnpm build",
    "test:soak": "node tests/soak/memory-soak.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "1.57.0",
    "country-flag-icons": "1.6.20",
    "idb": "8.0.3",
    "tldts": "7.4.9",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/chrome": "0.2.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.4.11",
    "@wxt-dev/browser": "0.2.2",
    "@wxt-dev/module-vue": "1.0.3",
    "cspell": "^9.8.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.8",
    "web-ext": "10.5.0",
    "wxt": "0.20.27",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.1": "0.6.1",
      "brace-expansion@<=5.0.11": "5.0.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "image-size@>=2.0.0 <2.0.4": "2.0.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "node-forge@<1.4.1": "1.4.1",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "shell-quote@<1.12.0": "1.12.0",
      "smol-toml@<1.9.0": "1.9.0",
      "source-map-js@<1.2.2": "1.2.2",
      "tmp@<0.2.7": "0.2.7",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=8.0.0 <8.3.4": "8.3.4"
    }
  }
}
